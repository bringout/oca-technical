#. module: base_name_search_improved
#: model_terms:ir.ui.view,arch_db:base_name_search_improved.view_model_form_new
msgid ""
"<b>IMPORTANT:</b> Please note that enabling smart search may affect the "
"performance of searches and the system in general."
msgstr ""
"<b>VAŽNO:</b> Molimo imajte na umu da omogućavanje pametne pretrage može "
"utjecati na performanse pretrage i sistema uopšte."

#. module: base_name_search_improved
#: model_terms:ir.ui.view,arch_db:base_name_search_improved.view_model_form_new
msgid ""
"<b>Smart Name Search</b>: when searching for a record from another record "
"through the m2o/m2m widgets, for example when adding a Product in a Sales "
"Order Line or when selecting a Contact in an Invoice."
msgstr ""
"<b>Pametna pretraga naziva</b>: koristi se pri traženju zapisa iz drugog "
"zapisa kroz m2o/m2m vidžete, na primjer kada dodajete proizvod u stavku "
"prodajne narudžbe ili birate kontakt na fakturi."

#. module: base_name_search_improved
#: model_terms:ir.ui.view,arch_db:base_name_search_improved.view_model_form_new
msgid ""
"<b>Smart Search Fields</b>. You can define a set of fields by which we want "
"to search"
msgstr ""
"<b>Pametna polja pretrage</b>. Možete definirati skup polja po kojima želimo"
" pretraživati"

#. module: base_name_search_improved
#: model_terms:ir.ui.view,arch_db:base_name_search_improved.view_model_form_new
msgid ""
"<b>Smart Search</b>: when searching in list, kanban and other views, the "
"first option will be to search using \"Smart Search\""
msgstr ""
"<b>Pametna pretraga</b>: when searching in list, kanban and other views, the"
" first option will be to search using \"Smart Search\""

